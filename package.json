{
  "name": "golden-vector-provenance",
  "version": "0.6.0",
  "description": "Reproducible provenance for computed answers: a canonical SHA-256 fixed point (RFC 8785 JCS) that anyone can re-derive for free, so you recompute the answer instead of trusting the server.",
  "keywords": [
    "provenance",
    "reproducible",
    "canonicalization",
    "rfc8785",
    "jcs",
    "ed25519",
    "attestation",
    "receipt",
    "verifiable",
    "x402",
    "agents",
    "middleware",
    "express",
    "hono"
  ],
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./gvp": "./ref/js/gvp.mjs",
    "./attest": "./ref/js/attest.mjs",
    "./schema/receipt": "./schema/receipt.schema.json",
    "./schema/revocation-list": "./schema/revocation-list.schema.json",
    "./vectors": "./vectors/expected.json",
    "./package.json": "./package.json",
    "./middleware": "./middleware/index.mjs",
    "./vectors/attestation-v2": "./vectors/attestation-v2.json"
  },
  "files": [
    "index.mjs",
    "ref/js/",
    "ref/py/gvp.py",
    "ref/py/attest.py",
    "spec/",
    "schema/",
    "vectors/",
    "tools/",
    "README.md",
    "LICENSE",
    "LICENSE-APACHE-2.0",
    "LICENSE-CC-BY-4.0",
    "middleware/index.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node tools/check-js.mjs && node tools/check-jcs.mjs && node tools/check-l2-binding.mjs && node tools/check-fixedpoint-2.mjs && node middleware/test.mjs",
    "check:l1l2": "node tools/check-js.mjs",
    "check:jcs": "node tools/check-jcs.mjs",
    "vectors": "node tools/gen-vectors.mjs",
    "attestation": "node tools/gen-attestation.mjs",
    "check:mw": "node middleware/test.mjs",
    "check:l2": "node tools/check-l2-binding.mjs",
    "check:fp2": "node tools/check-fixedpoint-2.mjs",
    "vectors:v2": "node tools/gen-vectors-v2.mjs",
    "verifier-precondition": "node tools/check-js.mjs && node tools/check-jcs.mjs && node tools/check-fixedpoint-2.mjs"
  },
  "devDependencies": {
    "canonicalize": "^2.1.0"
  },
  "license": "Apache-2.0 AND CC-BY-4.0",
  "author": "Solomon Dzukey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SolomonisBlack/golden-vector-provenance.git"
  },
  "homepage": "https://github.com/SolomonisBlack/golden-vector-provenance#readme",
  "bugs": {
    "url": "https://github.com/SolomonisBlack/golden-vector-provenance/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
